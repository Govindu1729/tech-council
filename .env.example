# Tech@IITGN Website — Environment Variables
# Copy this file to `.env.local` and fill in your values:
#   cp .env.example .env.local

# ============================================
# NextAuth.js (Authentication)
# ============================================
# URL of your deployed site (required in production)
NEXTAUTH_URL=http://localhost:3000
# Random secret used to sign/encrypt JWT sessions (32+ chars recommended)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Firebase (Authentication, Firestore, Storage)
# ============================================
# Client-side Firebase config (from Firebase project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-side Firebase Admin service account (JSON, one line)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# ============================================
# Email (Nodemailer / contact form)
# ============================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
